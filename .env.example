# Copia este archivo a .env.local para probar en tu ordenador (no lo subas nunca a GitHub)

# --- OPCIONAL: reflexión con IA ---
# Si dejas esto en "false" (o lo borras), el botón "Recibir una reflexión"
# simplemente no aparece — el resto de la app funciona igual, gratis y sin
# ninguna clave. Actívalo más adelante cuando quieras sumar esa función.
VITE_ENABLE_REFLECTIONS=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Código que tus compradoras usarán para entrar a la app.
# Si lo dejas vacío, la app queda abierta sin código (no recomendado si vas a venderla).
VITE_ACCESS_CODE=RAICES2026
